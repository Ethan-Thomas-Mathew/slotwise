# ${API_URL} is filled in from the environment when the container starts.
server {
  listen 8080;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 128k;

  # The API sets its own security headers.
  location /api/ {
    proxy_pass ${API_URL}/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed build files never change: cache them for a year. Missing files are 404s.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Client-side routes (/app/..., /b/...) all load index.html.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
