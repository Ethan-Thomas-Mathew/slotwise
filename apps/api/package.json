{
  "name": "@slotwise/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset-db.ts",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx --env-file-if-exists=.env scripts/bench.ts",
    "openapi": "tsx scripts/openapi.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/ops/backup.ts",
    "db:restore-drill": "tsx --env-file-if-exists=.env scripts/ops/restore-drill.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@slotwise/shared": "workspace:*",
    "bullmq": "^5.81.6",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "kysely": "^0.28.20",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "4.1.12",
    "pino-pretty": "^13.2.0",
    "smtp-server": "^3.21.7",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
