# Copy to apps/api/.env and fill in. Never commit the real .env.

# --- Server ---
NODE_ENV=development
PORT=3000
# Where the React app runs. Used for CORS and for links in emails.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Database ---
# The API connects as the non-owner role, so Row-Level Security applies.
DATABASE_URL=postgresql://slotwise_app:app_password@localhost:5432/slotwise
# Migrations run as the role that owns the tables.
MIGRATION_DATABASE_URL=postgresql://slotwise_owner:owner_password@localhost:5432/slotwise

# --- Redis (BullMQ jobs + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
SESSION_TTL_DAYS=7

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Slotwise <no-reply@slotwise.local>"

# --- Payments ---
# "mock" lets you click "Simulate payment" locally without Razorpay keys.
# "razorpay" uses real Razorpay test-mode keys below.
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret

# --- Monitoring (optional) ---
SENTRY_DSN=
# Prometheus metrics on their own port (never the public one). 127.0.0.1 = this computer only.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
WORKER_METRICS_PORT=9465

# --- API docs ---
# Interactive docs at /docs. Default: on unless NODE_ENV=production.
# API_DOCS=false
